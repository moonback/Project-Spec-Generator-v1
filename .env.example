# OpenRouter (génération des specs)
VITE_OPENROUTER_API_KEY="your_openrouter_api_key"

# Un seul modèle (prioritaire si défini)
# VITE_OPENROUTER_MODEL="arcee-ai/trinity-large-thinking:free"

# Liste de modèles proposés dans l’UI (virgule). Sinon : défauts applicatifs.
# VITE_OPENROUTER_MODELS="arcee-ai/trinity-large-thinking:free,openai/gpt-oss-120b:free"

# Supabase (obligatoire pour lancer l’app)
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
